<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Hours third-party notices</title>
  <style>
    body { max-width: 76ch; margin: 3rem auto; padding: 0 1rem; font-family: system-ui, sans-serif; line-height: 1.6; }
    pre { white-space: pre-wrap; overflow-wrap: anywhere; font-size: 0.9rem; }
    section { border-top: 1px solid #aaa; margin-top: 2rem; }
  </style>
</head>
<body>
  <h1>Hours third-party notices</h1>
  <p>Generated by cargo-about from Cargo.lock for the Apple Silicon macOS build.
     This file includes Rust dependencies and build dependencies. It is not a complete license audit.</p>
  <p>The linked crate archives provide the corresponding, unmodified dependency source code,
     including the source of dependencies licensed under MPL 2.0.
     Project and bundled font licenses are also included in this app's Resources directory.</p>
  {{#each licenses}}
  <section>
    <h2>{{name}}</h2>
    <ul>
      {{#each used_by}}
      <li>{{crate.name}} {{crate.version}}
        {{#if crate.source}} &middot; <a href="https://crates.io/api/v1/crates/{{crate.name}}/{{crate.version}}/download">source archive</a>{{/if}}
        {{#if crate.repository}} &middot; <a href="{{crate.repository}}">repository</a>{{/if}}
      </li>
      {{/each}}
    </ul>
    <pre>{{text}}</pre>
  </section>
  {{/each}}
</body>
</html>
